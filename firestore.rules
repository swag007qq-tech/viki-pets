rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'swag007qq@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAnonymousSession() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function canManageCatalog() {
      return isAdmin() || isAnonymousSession();
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'stock', 'imageUrl', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'price', 'stock', 'imageUrl', 'isPublic', 'rarities', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.price is number
        && data.price >= 0
        && data.price <= 1000000
        && data.stock is int
        && data.stock >= 0
        && data.stock <= 100000
        && data.imageUrl is string
        && data.imageUrl.size() <= 400000
        && data.isPublic is bool
        && data.isPublic == true
        && (!('rarities' in data) || (
          data.rarities is list
          && data.rarities.size() <= 4
          && data.rarities.hasOnly(['F', 'R', 'N', 'M'])
          && (data.rarities.size() == 0 || data.rarities[0] is string)
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogMeta(data) {
      return data.keys().hasAll(['seeded', 'updatedAt'])
        && data.keys().hasOnly(['seeded', 'updatedAt'])
        && data.seeded is bool
        && data.updatedAt is timestamp;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (resource == null || existing().isPublic == true || canManageCatalog());
      allow list: if resource.data.isPublic == true || canManageCatalog();
      allow create: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && canManageCatalog();
      allow update: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'stock', 'imageUrl', 'rarities', 'updatedAt'])
        && canManageCatalog();
      allow delete: if isSignedIn() && isValidId(productId) && canManageCatalog();
    }

    match /meta/{metaId} {
      allow get: if isValidId(metaId) && metaId == 'catalog';
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(metaId)
        && metaId == 'catalog'
        && isValidCatalogMeta(incoming())
        && incoming().updatedAt == request.time
        && canManageCatalog();
      allow update: if isSignedIn()
        && isValidId(metaId)
        && metaId == 'catalog'
        && isValidCatalogMeta(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['seeded', 'updatedAt'])
        && canManageCatalog();
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }
  }
}
